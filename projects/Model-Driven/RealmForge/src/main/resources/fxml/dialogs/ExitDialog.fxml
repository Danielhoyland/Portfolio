<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.jfoenix.controls.JFXButton?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="no.ntnu.idatg2001.frontend.dialogControllers.ExitDialogController"
      alignment="CENTER" spacing="15"
      stylesheets="@/css/ExitDialog.css"
      prefWidth="360" prefHeight="180"
      style="-fx-background-color: rgba(25,25,25,0.95); -fx-padding: 20; -fx-background-radius: 10; -fx-border-radius: 10;">

    <Label fx:id="titleLabel" text="Exit Game?" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label fx:id="messageLabel" text="Are you sure you want to exit?"/>

    <HBox alignment="CENTER" spacing="10">
        <JFXButton fx:id="exitButton" text="Exit" onAction="#onExitPressed"/>
        <JFXButton fx:id="cancelButton" text="Cancel" onAction="#onCancelPressed"/>
    </HBox>
</VBox>
