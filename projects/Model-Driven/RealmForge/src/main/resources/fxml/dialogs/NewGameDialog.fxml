<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.jfoenix.controls.JFXButton?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="no.ntnu.idatg2001.frontend.dialogControllers.NewGameDialogController"
           stylesheets="@/css/newGameDialog.css"
           styleClass="dialog-root">

    <VBox alignment="CENTER" spacing="20">
        <!-- Header -->
        <Label fx:id="newGameLabel"
               text="%newGameHeaderText"
               wrapText="true"
               styleClass="dialog-header"/>

        <!-- Buttons -->
        <VBox spacing="12" alignment="CENTER">
            <JFXButton fx:id="playNewStoryButton"
                       text="%playNewStoryButton"
                       prefWidth="300"
                       prefHeight="30"
                       styleClass="dialog-button"
                       onAction="#onPlayNewStoryButtonPressed"/>

            <JFXButton fx:id="createStoryButton"
                       text="%createStoryButton"
                       prefWidth="300"
                       prefHeight="30"
                       styleClass="dialog-button"
                       onAction="#onCreateStoryButtonPressed"/>

            <!-- 🔥 New button for the mini-game -->
            <JFXButton fx:id="playMiniGameButton"
                       text="Play Mini Game"
                       prefWidth="300"
                       prefHeight="30"
                       styleClass="dialog-button"
                       onAction="#onPlayMiniGameButtonPressed"/>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <JFXButton fx:id="backToMainMenuButton"
                       text="%backToMainMenuButton"
                       styleClass="dialog-back-button"/>
        </HBox>
    </VBox>
</StackPane>
