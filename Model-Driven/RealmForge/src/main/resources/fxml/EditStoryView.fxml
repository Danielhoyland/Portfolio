<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="no.ntnu.idatg2001.frontend.controller.EditStoryController"
            stylesheets="@/css/EditStoryView.css"
            xmlns="http://javafx.com/javafx"
            style="-fx-background-color: rgba(25, 25, 25, 0.9);">

    <padding>
        <Insets top="10" left="10" right="10" bottom="10"/>
    </padding>

    <!-- Top: Button Bar -->
    <top>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="5" bottom="10"/>
            </padding>
            <ButtonBar fx:id="buttonBar" prefHeight="40.0">
                <buttons>
                    <JFXButton fx:id="addPassageButton" wrapText="true" onAction="#onAddPassageButtonPressed"/>
                    <JFXButton fx:id="addLinkButton" wrapText="true" onAction="#onAddLinkButtonPressed"/>
                    <JFXButton fx:id="addActionButton" wrapText="true" onAction="#onAddActingButtonPressed"/>
                    <JFXButton fx:id="editButton" wrapText="true" onAction="#onEditButtonIsPressed"/>
                    <JFXButton fx:id="deleteButton" wrapText="true" onAction="#onDeleteButtonPressed"/>
                    <JFXButton fx:id="mapButton" wrapText="true" onAction="#onMapPressed"/>
                    <JFXButton fx:id="exportButton" wrapText="true" onAction="#onExportPress"/>
                    <JFXButton fx:id="backButton" wrapText="true" cancelButton="true" onAction="#onBackButtonPressed"/>
                </buttons>
            </ButtonBar>
        </HBox>
    </top>

    <!-- Left: Passage TableView -->
    <left>
        <TableView fx:id="passageTableView" prefWidth="400" onMouseClicked="#onPassageTableClicked">
            <columns>
                <TableColumn fx:id="passageTableColumn" prefWidth="400" reorderable="false"/>
            </columns>
        </TableView>
    </left>

    <!-- Center: Content Area -->
    <center>
        <HBox>
            <padding>
                <Insets top="20" left="20" right="20" bottom="20"/>
            </padding>
            <VBox fx:id="contentBox" HBox.hgrow="ALWAYS">
                <!-- Passage Content TextArea -->
                <JFXTextArea fx:id="passageContentTextArea" 
                            prefHeight="380" 
                            editable="false" 
                            wrapText="true"
                            style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 1;"
                            VBox.vgrow="SOMETIMES"/>

                <!-- Link and Action Tables -->
                <HBox fx:id="linkBox" VBox.vgrow="ALWAYS">
                    <!-- Link TableView -->
                    <TableView fx:id="linkTableView" prefWidth="400" onMouseClicked="#onLinkTableClicked" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="linkTableLinkNameColumn" reorderable="false"/>
                            <TableColumn fx:id="linkTableLinkReferenceColumn" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- Action TableView -->
                    <TableView fx:id="actionTableView" prefWidth="400" editable="false" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="actionTableColumn" reorderable="false"/>
                            <TableColumn fx:id="actionTableActionColumn" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
