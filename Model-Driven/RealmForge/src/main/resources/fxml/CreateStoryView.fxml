<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="no.ntnu.idatg2001.frontend.controller.CreateStoryController"
            stylesheets="@/css/NewStoryView.css"
            xmlns="http://javafx.com/javafx"
            style="-fx-background-color: rgba(0, 0, 0, 0.9);">

    <padding>
        <Insets top="130" left="100" right="100"/>
    </padding>

    <center>
        <VBox alignment="TOP_CENTER">
            <!-- Story TableView -->
            <TableView fx:id="storyTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="columnStoryName" prefWidth="100" reorderable="false"/>
                    <TableColumn fx:id="columnStoryPassageAmount" prefWidth="100" reorderable="false"/>
                    <TableColumn fx:id="columnStoryLinkAmount" prefWidth="100" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- Button Bar -->
            <HBox alignment="BOTTOM_CENTER">
                <padding>
                    <Insets top="25"/>
                </padding>
                <ButtonBar fx:id="buttonBar" buttonMinWidth="10">
                    <buttons>
                        <JFXButton fx:id="storyNameButton" onAction="#onNewStory"/>
                        <JFXButton fx:id="editStoryButton" onAction="#onEditButton"/>
                        <JFXButton fx:id="deleteButton" onAction="#onDeleteButtonPressed"/>
                        <JFXButton fx:id="importButton" onAction="#onImportButtonPressed"/>
                        <JFXButton fx:id="backButton" cancelButton="true" onAction="#onBackToMainMenuButtonPressed"/>
                    </buttons>
                </ButtonBar>
            </HBox>
        </VBox>
    </center>
</BorderPane>
